# ============================================================================
# API Configuration - Frontend
# ============================================================================

# VITE_API_URL: Backend API endpoint
# 
# IMPORTANT: This MUST be set for production deployments!
#
# Examples:
#   Development:   VITE_API_URL=http://localhost:4000
#   Local Network: VITE_API_URL=http://192.168.1.100:4000
#   Production:    VITE_API_URL=https://api.yourdomain.com
#   Railway:       VITE_API_URL=https://your-app-abc123.railway.app
#   Heroku:        VITE_API_URL=https://your-app-name.herokuapp.com
#
# Without this variable, the app will attempt auto-detection which will fail
# in production (Netlify will try to connect to netlify.app:4000)
VITE_API_URL=

# ============================================================================
# Backend Server Configuration
# ============================================================================

# NODE_ENV: Node environment
#   development = Allow all CORS, verbose logging
#   production = Restricted CORS, less logging
NODE_ENV=development

# HOST: Server binding address
#   0.0.0.0 = Listen on all interfaces (required for network access)
#   localhost = Only accessible from this machine
#   specific-ip = Bind to specific IP address
HOST=0.0.0.0

# PORT: Server port
#   4000 = Default (change if port is in use)
#   5000, 8080, etc. = Alternative ports
#   auto/unset = Platform assigns (Heroku, Railway, etc.)
PORT=4000

# ============================================================================
# CORS Configuration - Backend
# ============================================================================

# FRONTEND_URL: Frontend domain for production CORS
#
# IMPORTANT: Set this in production to restrict CORS to your domain only!
#
# Examples:
#   Production: FRONTEND_URL=https://your-site.netlify.app
#   Custom:     FRONTEND_URL=https://yourdomain.com
#
# This is used in the CORS middleware to allow requests ONLY from this origin.
# If not set, development mode allows all origins.
FRONTEND_URL=

# ALLOW_ALL_CORS: Allow requests from any origin
#   true = Allow all origins (development only)
#   false or unset = Restricted CORS in production
ALLOW_ALL_CORS=true

# ============================================================================
# Quick Setup Instructions
# ============================================================================

# For LOCAL DEVELOPMENT:
# - Leave VITE_API_URL blank (auto-detection works)
# - Backend runs on localhost:4000
# - Frontend runs on localhost:5173
# Result: npm run dev && npm run json-server

# For LOCAL NETWORK TESTING (Mobile):
# - VITE_API_URL=http://192.168.1.100:4000
# - Backend listens on 0.0.0.0:4000
# - Mobile accesses from same WiFi
# Result: Mobile login works

# For PRODUCTION (Netlify + External Backend):
# - VITE_API_URL=https://api.yourdomain.com (or Railway/Heroku URL)
# - FRONTEND_URL=https://your-site.netlify.app
# - NODE_ENV=production
# - ALLOW_ALL_CORS=false
# Result: Secure production deployment

# ============================================================================
# Platform-Specific Examples
# ============================================================================

# RAILWAY DEPLOYMENT:
# Backend Environment Variables:
#   NODE_ENV=production
#   FRONTEND_URL=https://your-site.netlify.app
#   HOST=0.0.0.0
#   (PORT is auto-assigned by Railway)
#
# Frontend (Netlify) Environment Variables:
#   VITE_API_URL=https://your-app-xyz.railway.app

# HEROKU DEPLOYMENT:
# Backend Config Vars:
#   NODE_ENV=production
#   FRONTEND_URL=https://your-site.netlify.app
#   (HOST and PORT configured automatically)
#
# Frontend (Netlify) Environment Variables:
#   VITE_API_URL=https://your-app-name.herokuapp.com

# CUSTOM DOMAIN:
# Backend:
#   NODE_ENV=production
#   FRONTEND_URL=https://app.yourdomain.com
#   HOST=0.0.0.0
#   PORT=5000
#
# Frontend:
#   VITE_API_URL=https://api.yourdomain.com

