# API Configuration
# For development: leave blank or set to http://localhost:4000
# For production: set to your backend server URL (e.g., https://api.yourdomain.com)
# For mobile testing on local network: set to http://YOUR_MACHINE_IP:4000
VITE_API_URL=

# Backend Server Configuration
# HOST: IP address or hostname to bind the server to
#   '0.0.0.0' (default) - Listen on all network interfaces (required for mobile access)
#   'localhost' - Only listen on localhost (dev only)
HOST=0.0.0.0

# PORT: Server port (default: 4000)
PORT=4000
